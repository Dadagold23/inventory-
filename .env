# Inventory Management System - Environment Configuration
# Copy this file to .env and adjust values for your deployment

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory
DB_USER=root
DB_PASSWORD=

# Application URL
APP_URL=http://localhost/inventory

# Application Environment
APP_ENV=production
APP_DEBUG=false

# Secret storage key (32 random bytes, hex). Encrypts payment gateway
# credentials at rest. Changing it makes stored credentials unreadable -
# re-enter them on the Payment Gateways screen instead.
APP_KEY=5aaaf8c4a1b563c58288eae826b1192b101313e8f07ac872a7aaa9a907aef086

# Workshop switch: allow simulated gateway payments (no real money) while no
# live keys are configured. Must be absent or false on a machine that takes
# real payments.
GATEWAY_SANDBOX=true

# Session Configuration
SESSION_DRIVER=files
SESSION_LIFETIME=120

# Feature Flags
FEATURE_APPROVALS=true
FEATURE_PAYROLL=true
FEATURE_TAX=true
FEATURE_DASHBOARD=true