# Inventory Management System - Environment Configuration Example
# This file should be copied to .env and customized for your deployment

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory
DB_USER=inventory_app
DB_PASSWORD=change-me

# Application URL
APP_URL=http://localhost/inventory

# Application Environment
APP_ENV=production
APP_DEBUG=false

# Secret storage key: 32 random bytes as 64 hex characters. Encrypts payment
# gateway credentials at rest. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# If it is left blank the app writes one to storage/keys/app.key on first use.
# Changing it invalidates stored credentials - re-enter them instead.
APP_KEY=

# Workshop switch: allow simulated gateway payments (test mode, no live keys,
# no real money) on this host even when APP_ENV=production. Leave absent or
# false on any machine that takes real payments; the Payment Gateways screen
# warns while both are set.
GATEWAY_SANDBOX=false

# Session Configuration
SESSION_DRIVER=files
SESSION_LIFETIME=120

# Feature Flags (can be: true/false or 1/0)
FEATURE_APPROVALS=true
FEATURE_PAYROLL=true
FEATURE_TAX=true
FEATURE_DASHBOARD=true